(function() {
    var checkExist = setInterval(function() {
       var element = document.querySelector('#menu-item-21 a');
       if (element) {
          element.classList.add('cta_1');
          console.log("Classe cta_1 aggiunta con successo!");
          clearInterval(checkExist);
       }
    }, 100); // Controlla ogni 100ms finché non lo trova
})();;
